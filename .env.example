# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_editor

# Storage
UPLOAD_DIR=/tmp/video_editor/uploads
WORK_DIR=/tmp/video_editor/work
OUTPUT_DIR=/tmp/video_editor/outputs

# AI APIs
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...

# Claude model for agent_decision steps
CLAUDE_MODEL=claude-opus-4-6

# FFmpeg binary (default: system ffmpeg)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Job queue concurrency
MAX_CONCURRENT_JOBS=2

# API settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
